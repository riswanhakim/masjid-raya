# Salin berkas ini menjadi .env lalu isi nilainya.

# Kunci penandatangan sesi NextAuth. WAJIB diisi dan WAJIB acak.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sesi semua pengguna batal bila nilai ini diganti.
NEXTAUTH_SECRET=

# Alamat aplikasi. Wajib https di produksi agar cookie sesi dikirim terenkripsi.
NEXTAUTH_URL="http://localhost:3000"

# PostgreSQL Supabase (Project Settings > Database > Connection string).
# DATABASE_URL: pooler mode transaksi, port 6543, untuk aplikasi di Vercel.
# DIRECT_URL:   koneksi langsung/session, port 5432, untuk `npm run db:migrate`.
DATABASE_URL="postgresql://postgres.[ID-PROYEK]:[SANDI-DB]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[ID-PROYEK]:[SANDI-DB]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage untuk foto, suara adzan, dan bukti transaksi.
# Project Settings > API: Project URL dan kunci service_role.
# Kunci service_role HANYA untuk server; jangan pernah taruh di kode browser.
# Bila dikosongkan, berkas disimpan ke disk lokal (UPLOAD_DIR).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: database khusus tes integrasi (`npm test`), mis. proyek dev
# dengan ?schema=uji di ujung URL.
TEST_DATABASE_URL=

# Kata sandi akun awal yang dibuat `npm run db:seed`.
# Bila dibiarkan kosong, seed memakai sandi bawaan yang TIDAK aman untuk produksi.
SEED_ADMIN_PASSWORD=
SEED_PENGURUS_PASSWORD=

# Direktori penyimpanan berkas unggahan (foto, suara adzan).
# Bila dikosongkan, dipakai folder `uploads/` di akar proyek.
# Di produksi arahkan ke volume yang tidak terhapus saat deploy.
UPLOAD_DIR=

# Isi hanya di server. Jangan masukkan token bot ke kode atau browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
